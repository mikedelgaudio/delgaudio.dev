// Cloudflare Workers static assets: serves the Vite build in dist/.
// Workers Builds runs `npm run build` on every push; main deploys to production.
{
  "name": "delgaudio-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths fall back to index.html so the app's 404 page renders
    "not_found_handling": "single-page-application"
  }
}
